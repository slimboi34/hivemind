# Hivemind configuration.
#
# Copy this file to .env and fill in the two keys:
#     cp .env.example .env
# .env is gitignored, so your keys stay on your machine and are never committed.

# ===== 1. Model key (required) =====
# Claude, through Anthropic's OpenAI-compatible endpoint.
# Get a key at https://console.anthropic.com/ -> API keys. It starts with "sk-ant-".
LLM_API_KEY=your_anthropic_api_key_here
LLM_BASE_URL=https://api.anthropic.com/v1/
# Haiku keeps a run cheap: every simulated participant makes a model call every round.
# A larger model (for example claude-sonnet-5-5) writes better but costs several times more.
LLM_MODEL_NAME=claude-haiku-5-5

# Any other OpenAI-compatible provider works too. Replace the three lines above, e.g.:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# ===== 2. Zep Cloud key (required) =====
# Stores the knowledge graph and agent memory. The free tier covers small runs.
# Get a key at https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Optional =====
# Keep the backend on this machine only (the default binds to the whole local network).
FLASK_HOST=127.0.0.1

# A second model endpoint, used for one of the two simulated platforms to spread load.
# Leave these out entirely unless you use them.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=

# God's Eye View live data (github.com/bilawalsidhu/gods-eye-view). No key needed.
# GODSEYE_URL=http://localhost:4173
